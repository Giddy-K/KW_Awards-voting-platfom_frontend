# Copy to `.env.local` (git-ignored) for local overrides.
# Vite only exposes variables prefixed with VITE_ to the browser: never put
# secrets in here.

# Base URL of the backend API (no trailing slash).
# Local default when unset (dev server only): http://localhost:8000/api
# Required at build time for production builds.
VITE_API_URL=http://localhost:8000/api
